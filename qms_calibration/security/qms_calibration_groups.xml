<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- QMS Calibration Module Privilege (Category) -->
        <record id="res_groups_privilege_qms_calibration" model="res.groups.privilege">
            <field name="name">QMS Calibration</field>
            <field name="sequence">61</field>
        </record>

        <!-- GROUP 1: USER (Read Only) -->
        <record id="group_qms_user" model="res.groups">
            <field name="name">User (Read Only)</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_qms_calibration"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view Gages. Cannot create, edit, or delete.</field>
        </record>

        <!-- GROUP 2: MANAGER (Operational Access) -->
        <record id="group_qms_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_qms_calibration"/>
            <field name="implied_ids" eval="[(4, ref('group_qms_user'))]"/>
            <field name="comment">Can create Gages, Log Events, and Edit. Cannot Delete or Unlock.</field>
        </record>

        <!-- GROUP 3: ADMINISTRATOR (Full Access) -->
        <record id="group_qms_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_qms_calibration"/>
            <field name="implied_ids" eval="[(4, ref('group_qms_manager'))]"/>
            <field name="comment">Full access including Deletion and Unlocking records.</field>
        </record>
    </data>
</odoo>
