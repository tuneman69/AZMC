<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Server Action: Unlocks record AND Reloads screen immediately -->
        <!-- CHECKLIST COMPLIANCE: No groups_id in XML. Security moved to Python code. -->
        <record id="action_server_unlock_calibration" model="ir.actions.server">
            <field name="name">Unlock for Correction</field>
            <field name="model_id" ref="model_qms_calibration_event"/>
            <field name="binding_model_id" ref="model_qms_calibration_event"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">
# Security Check via Python since XML groups_id is unstable in v19
if not env.user.has_group('qms_calibration.group_qms_admin'):
    raise UserError("ACCESS DENIED: Only Administrators can unlock finalized records.")

if record.state == 'done':
    record.action_reset_draft()
    action = {'type': 'ir.actions.client', 'tag': 'reload'}
            </field>
        </record>

        <record id="view_qms_calibration_event_form" model="ir.ui.view">
            <field name="name">qms.calibration.event.form</field>
            <field name="model">qms.calibration.event</field>
            <field name="arch" type="xml">
                <form string="Log Calibration Event">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info" role="status" invisible="state != 'done'">
                            <i class="fa fa-lock" title="Locked"/> 
                            <strong> LOCKED:</strong> This record is finalized. 
                            To edit, use <b>Action (Gear) &gt; Unlock for Correction</b> (Admins Only).
                        </div>

                        <!-- LOGIC CONTROL -->
                        <field name="control_type" invisible="1"/>

                        <div class="oe_title">
                            <label for="date_calibration" string="Date of Calibration" invisible="control_type == 'verification'"/>
                            <label for="date_calibration" string="Date of Verification" invisible="control_type == 'calibration'"/>
                            <h1><field name="date_calibration" readonly="state == 'done'"/></h1>
                            <h3>
                                <span class="text-muted">Gage: </span>
                                <field name="gage_id" readonly="1" options="{'no_open': True}"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Source &amp; Traceability">
                                <field name="calibrated_by_type" widget="radio" options="{'horizontal': true}" readonly="1" force_save="1"/>
                                
                                <field name="certificate_number" 
                                       string="Certificate Number" 
                                       readonly="calibrated_by_type == 'internal' or state == 'done'"
                                       force_save="1"
                                       placeholder="Enter Vendor Cert #"
                                       invisible="control_type == 'verification' and calibrated_by_type == 'internal'"/>
                                
                                <div class="text-muted" invisible="calibrated_by_type == 'external'">
                                    * System will auto-assign Internal ID upon confirmation.
                                </div>
                            </group>
                            
                            <group string="Provider Info">
                                <field name="external_vendor_id" 
                                       placeholder="Select or Create Vendor..."
                                       invisible="calibrated_by_type == 'internal'"
                                       required="calibrated_by_type == 'external'"
                                       readonly="state == 'done'"/>
                                <field name="internal_user_id" 
                                       invisible="calibrated_by_type == 'external'"
                                       required="calibrated_by_type == 'internal'"
                                       readonly="state == 'done'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Calibration Data">
                                
                                <group string="1. Condition As Found">
                                    <div class="alert alert-warning" role="status" colspan="2" invisible="as_found_condition == 'in_tolerance'">
                                        <strong>WARNING:</strong> Gage found Out of Tolerance. Impact Analysis Required.
                                    </div>
                                    <group>
                                        <field name="as_found_condition" widget="radio" readonly="state == 'done'"/>
                                    </group>
                                </group>

                                <group invisible="calibrated_by_type == 'external'" string="2. Internal Details">
                                    <field name="standards_used" required="calibrated_by_type == 'internal' and control_type == 'calibration'" readonly="state == 'done'"/>
                                    <field name="environment" required="calibrated_by_type == 'internal' and control_type == 'calibration'" readonly="state == 'done'"/>
                                    <separator string="Readings"/>
                                    <field name="as_found" string="As Found Readings" required="calibrated_by_type == 'internal'" readonly="state == 'done'"/>
                                    <field name="was_adjusted" readonly="state == 'done'"/>
                                    <field name="as_left" string="As Left Readings" required="calibrated_by_type == 'internal'" readonly="state == 'done'"/>
                                </group>

                                <group invisible="calibrated_by_type == 'internal'" string="2. External Details">
                                    <field name="certificate_attachment" filename="certificate_filename" readonly="state == 'done'"/>
                                    <field name="certificate_filename" invisible="1"/>
                                    <field name="as_found" string="Vendor Notes" readonly="state == 'done'"/>
                                </group>

                                <group string="3. Conclusion">
                                    <group>
                                        <field name="as_left_condition" widget="radio" readonly="state == 'done'"/>
                                        <field name="result" widget="radio" 
                                               readonly="state == 'done'" 
                                               required="state == 'done'"/>
                                    </group>
                                </group>

                                <group string="4. Impact Analysis" class="alert alert-danger" role="alert" invisible="result == 'pass' and as_found_condition == 'in_tolerance'">
                                    <field name="oot_impact_analysis" placeholder="Risk assessment..." required="result == 'fail' or as_found_condition == 'out_of_tolerance'" readonly="state == 'done'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <footer>
                        <button name="action_confirm" string="Confirm &amp; Log Result" type="object" class="btn-primary" invisible="state == 'done'"/>
                        
                        <button string="Close" class="btn-secondary" special="cancel" invisible="state == 'done'"/> 
                        <button string="Close" class="btn-primary" special="cancel" invisible="state != 'done'"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_qms_calibration_event_tree" model="ir.ui.view">
            <field name="name">qms.calibration.event.list</field>
            <field name="model">qms.calibration.event</field>
            <field name="arch" type="xml">
                <list string="History" decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                    <field name="date_calibration"/>
                    <field name="certificate_number" string="Cert #"/>
                    <field name="gage_description"/>
                    <field name="control_type" optional="hide"/>
                    <field name="result" widget="badge" decoration-danger="result == 'fail'" decoration-success="result == 'pass'"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="action_qms_calibration_event" model="ir.actions.act_window">
            <field name="name">Calibration Events</field>
            <field name="res_model">qms.calibration.event</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>