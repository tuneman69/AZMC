<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_qms_calibration_gage" model="ir.sequence">
            <field name="name">Gage Master Sequence</field>
            <field name="code">qms.calibration.gage</field>
            <field name="prefix">SYS-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_qms_calibration_internal_cert" model="ir.sequence">
            <field name="name">Internal Calibration Certificate</field>
            <field name="code">qms.calibration.certificate</field>
            <field name="prefix">INT-%(y)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>