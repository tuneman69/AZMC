<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_qms_verification">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- CHANGED TO web.internal_layout TO REMOVE BANK FOOTER -->
                <t t-call="web.internal_layout">
                    <div class="page">
                        <!-- HEADER -->
                        <div class="text-center mt-4 mb-4">
                            <h2>Document Verification Record</h2>
                            <h4><span t-field="doc.name"/> - Revision <span t-field="doc.revision"/></h4>
                        </div>

                        <!-- WATERMARK LOGIC -->
                        <!-- If NOT Published -> Print Big Warning -->
                        <div t-if="doc.state != 'published'" class="alert alert-warning text-center" role="alert">
                            <h1 style="font-weight:bold; color:red;">DRAFT / NOT CONTROLLED</h1>
                            <p>This document is NOT valid for production use.</p>
                        </div>

                        <!-- If Published -> Print Controlled Stamp -->
                        <div t-if="doc.state == 'published'" class="alert alert-success text-center" role="alert">
                            <h1 style="font-weight:bold; color:green;">CONTROLLED COPY</h1>
                            <p>Valid for Production Use</p>
                        </div>

                        <!-- META DATA TABLE -->
                        <table class="table table-bordered mt-4">
                            <tr>
                                <th style="background-color: #f2f2f2;">Document Title</th>
                                <td><span t-field="doc.title"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f2f2f2;">Current Status</th>
                                <td><span t-field="doc.state"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f2f2f2;">Folder Location</th>
                                <td><span t-field="doc.folder_id.complete_name"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f2f2f2;">Process Owner</th>
                                <td><span t-field="doc.process_owner_id.name"/></td>
                            </tr>
                        </table>

                        <!-- APPROVAL SECTION -->
                        <div class="mt-4 p-3 border border-dark">
                            <h3>Approval Authority</h3>
                            <div class="row mt-3">
                                <div class="col-6">
                                    <strong>Approved By:</strong><br/>
                                    <span t-field="doc.approved_by.name"/>
                                </div>
                                <div class="col-6">
                                    <strong>Date of Approval:</strong><br/>
                                    <span t-field="doc.approved_date"/>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER DISCLAIMER -->
                        <div class="text-muted text-center fixed-bottom mb-2">
                            <small>Generated by Odoo QMS. Physical copies are only valid if they match the current revision in the system.</small>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>