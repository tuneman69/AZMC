<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- REJECT WIZARD VIEW -->
<record id="view_qms_reject_wizard_form" model="ir.ui.view">
    <field name="name">qms.reject.wizard.form</field>
    <field name="model">qms.reject.wizard</field>
    <field name="arch" type="xml">
        <form string="Reason for Rejection">
            <field name="document_id" invisible="1"/>
            <group>
                <field name="reason" 
                       placeholder="Please provide a specific reason for rejection so the responsible party knows exactly what needs to be corrected..."
                       required="1"
                       nolabel="1"
                       widget="text"/>
            </group>
            <footer>
                <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn-danger"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
        </form>
    </field>
</record>


<!--  SERVER ACTION: DOWNLOAD  -->
<record id="action_qms_document_download" model="ir.actions.server">
    <field name="name">Download File</field>
    <field name="model_id" ref="model_qms_document"/>
    <field name="binding_model_id" ref="model_qms_document"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
action = records.action_mass_download()
    </field>
</record>

<!--  SEARCH VIEW  -->
<record id="view_qms_document_search" model="ir.ui.view">
    <field name="name">qms.document.search</field>
    <field name="model">qms.document</field>
    <field name="arch" type="xml">
        <search>
            <field name="name" string="Search All" filter_domain="['|', '|', ('name', 'ilike', self), ('title', 'ilike', self), ('keywords', 'ilike', self)]"/>
            <field name="keywords" string="Keyword Tag"/>
            <field name="title" string="Title"/>
            <field name="folder_id" string="Folder"/>
            
            <filter name="my_docs" string="My Documents" domain="['|', ('process_owner_id', '=', uid), ('quality_manager_id', '=', uid)]"/>
            
            <filter name="my_action_items" string="My Action Items" 
                    domain="['|', '&amp;', ('state', '=', 'review'), ('quality_manager_id', '=', uid),
                                  '&amp;', ('next_review_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('process_owner_id', '=', uid)]"/>

            <separator/>
            <filter name="published" string="Published Only" domain="[('state', '=', 'published')]"/>
            <filter name="overdue" string="Review Past Due" domain="[('next_review_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
            <separator/>
            <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
        </search>
    </field>
</record>

<!--  FORM VIEW  -->
<record id="view_qms_document_form" model="ir.ui.view">
    <field name="name">qms.document.form</field>
    <field name="model">qms.document</field>
    <field name="arch" type="xml">
        <form string="Controlled Document">
            <header>
                <button name="action_open_file" string="Open/Print Document" type="object" class="btn-primary" icon="fa-print"/>
                
                <button name="action_submit" string="Submit for Review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                <button name="action_approve_reviewer" string="Approve (Reviewer)" type="object" class="oe_highlight" invisible="state != 'review'"/>
                <button name="action_publish" string="Final Publish" type="object" class="oe_highlight" invisible="state != 'qm_approval'"/>
                
                <button name="action_confirm_review" string="Confirm Review (No Changes)" type="object" class="btn-warning" 
                        invisible="state != 'published'" confirm="Extend validity for 1 year?"/>
                
                <button name="action_send_reminder" string="Email Reminder" type="object" 
                        invisible="state != 'published'" icon="fa-envelope-o"/>

                <button name="action_new_revision" string="Create Revision" type="object" class="btn-secondary" invisible="state != 'published'"/>
                
                <button name="action_reset_draft" string="Reset / Reject" type="object" 
                        invisible="state == 'draft' or state == 'published' or state == 'obsolete'"/>
                
                <field name="state" widget="statusbar" statusbar_visible="draft,review,qm_approval,published"/>
            </header>
            <sheet>
                <!-- SMART BUTTON FOR HISTORY -->
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_revisions" type="object" class="oe_stat_button" icon="fa-history">
                        <field name="revision_count" widget="statinfo" string="Revisions"/>
                    </button>
                </div>

                <!-- Archive Ribbon -->
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                
                <field name="state" invisible="1"/>
                <field name="is_overdue" invisible="1"/>
                <field name="active" invisible="1"/>
                
                <div class="alert alert-danger text-center" role="alert" invisible="not is_overdue">
                    <strong>ATTENTION:</strong> This document is past its Annual Review date. Please Review or Revise immediately.
                </div>

                <div class="oe_title">
                    <label for="name" string="Document Number"/>
                    <h1>
                        <field name="name" placeholder="e.g. QA-SOP-001" required="1" readonly="state != 'draft'"/>
                    </h1>
                    <label for="title" string="Title"/>
                    <h2>
                        <field name="title" placeholder="e.g. Purchasing SOP" required="1" readonly="state != 'draft'"/>
                    </h2>
                    <label for="keywords"/>
                    <field name="keywords" placeholder="Search Tags: e.g. procurement, buying, vendors"/>
                </div>
                <group>
                    <group>
                        <field name="revision" readonly="state != 'draft'"/>
                        <field name="folder_id" required="1" options="{'no_create': False}" readonly="state != 'draft'"/>
                        <field name="doc_file" filename="file_name" readonly="state != 'draft'"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group>
                        <field name="process_owner_id" readonly="state != 'draft'"/>
                        <field name="reviewer_id" readonly="state != 'draft'" required="state == 'draft'" options="{'no_create': True}"/>
                        <field name="quality_manager_id" readonly="state != 'draft'"/>
                        <field name="approved_by"/>
                        <field name="approved_date"/>
                        <field name="next_review_date"/>
                    </group>
                </group>
            </sheet>
            <chatter/>
        </form>
    </field>
</record>

<!--  LIST VIEW  -->
<record id="view_qms_document_tree" model="ir.ui.view">
    <field name="name">qms.document.list</field>
    <field name="model">qms.document</field>
    <field name="arch" type="xml">
        <list string="Documents" 
              decoration-info="state == 'draft'" 
              decoration-muted="state == 'obsolete'"
              decoration-danger="is_overdue == True">
            
            <field name="name"/>
            <field name="title"/>
            <field name="revision"/>
            <field name="folder_id"/>
            <field name="process_owner_id" optional="hide"/>
            <field name="next_review_date" optional="show"/>
            <field name="is_overdue" invisible="1"/>
            <field name="state" widget="badge" decoration-success="state == 'published'"/>
        </list>
    </field>
</record>

<!--  ACTION: Published -->
<record id="action_qms_document" model="ir.actions.act_window">
    <field name="name">Documents</field>
    <field name="res_model">qms.document</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_qms_document_search"/>
    <field name="context">{'search_default_published': 1}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face"> Upload your first Controlled Document </p>
    </field>
</record>

<!-- METRICS: PIVOT VIEW -->
<record id="view_qms_document_pivot" model="ir.ui.view">
    <field name="name">qms.document.pivot</field>
    <field name="model">qms.document</field>
    <field name="arch" type="xml">
        <pivot string="QMS Document Metrics" disable_linking="0">
            <field name="create_year" type="row"/>
            <field name="state" type="col"/>
        </pivot>
    </field>
</record>

<!-- METRICS: GRAPH VIEW -->
<record id="view_qms_document_graph" model="ir.ui.view">
    <field name="name">qms.document.graph</field>
    <field name="model">qms.document</field>
    <field name="arch" type="xml">
        <graph string="QMS Document Metrics" type="bar">
            <field name="create_year" type="row"/>
            <field name="state" type="col"/>
        </graph>
    </field>
</record>

<!-- METRICS: LIST VIEW FOR OVERDUE -->
<record id="view_qms_document_metrics_list" model="ir.ui.view">
    <field name="name">qms.document.metrics.list</field>
    <field name="model">qms.document</field>
    <field name="arch" type="xml">
        <list string="Documents" 
              decoration-danger="is_overdue == True"
              decoration-muted="state == 'obsolete'">
            <field name="name"/>
            <field name="title"/>
            <field name="revision"/>
            <field name="folder_id"/>
            <field name="state" widget="badge" decoration-success="state == 'published'" decoration-warning="state == 'review' or state == 'qm_approval'"/>
            <field name="process_owner_id"/>
            <field name="create_year" string="Year Created"/>
            <field name="approved_year" string="Year Published"/>
            <field name="days_to_publish" string="Days to Publish"/>
            <field name="next_review_date"/>
            <field name="is_overdue" invisible="1"/>
        </list>
    </field>
</record>

<!-- METRICS: ACTIONS -->
<record id="action_qms_metrics_pivot" model="ir.actions.act_window">
    <field name="name">Document Metrics</field>
    <field name="res_model">qms.document</field>
    <field name="view_mode">graph,pivot,list</field>
    <field name="context">{'active_test': False}</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No document data available yet.</p>
    </field>
</record>

<record id="action_qms_metrics_overdue" model="ir.actions.act_window">
    <field name="name">Overdue Reviews</field>
    <field name="res_model">qms.document</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','=','published'),('next_review_date','&lt;',context_today().strftime('%Y-%m-%d'))]</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">No overdue documents. Great work!</p>
    </field>
</record>

<record id="action_qms_metrics_by_folder" model="ir.actions.act_window">
    <field name="name">Documents by Folder</field>
    <field name="res_model">qms.document</field>
    <field name="view_mode">list,pivot,graph</field>
    <field name="context">{'active_test': False, 'search_default_group_folder': 1}</field>
</record>

</odoo>