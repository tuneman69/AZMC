<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_training_certificate" model="ir.actions.report">
        <field name="name">Training Certificate</field>
        <field name="model">ct.log</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">compliance_training.report_certificate_document</field>
        <field name="report_file">compliance_training.report_certificate_document</field>
        <field name="print_report_name">'Certificate - %s - %s' % (object.trainee_id.name, object.content_id.title)</field>
        <field name="binding_model_id" ref="model_ct_log"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_certificate_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica', sans-serif;">
                        <div class="text-center mt-4">
                            <h1>CERTIFICATE OF COMPETENCY</h1>
                            <p style="font-size: 1.2em; color: #666;">This certifies that</p>
                            <h2 style="border-bottom: 2px solid #000; padding-bottom: 10px; display: inline-block;">
                                <span t-field="o.trainee_id.name"/>
                            </h2>
                            <p class="mt-4" style="font-size: 1.2em;">Has successfully completed the training requirement:</p>
                            <h3><span t-field="o.content_id.title"/> (Rev <span t-field="o.content_id.revision"/>)</h3>
                            <p class="mt-4"><strong>Date of Completion:</strong> <span t-field="o.completion_date" t-options='{"widget": "date"}'/></p>
                            
                            <!-- Display Score if Online, or Method if OTJ -->
                            <p t-if="o.delivery_method == 'online'"><strong>Score:</strong> <span t-field="o.quiz_score"/></p>
                            <p t-if="o.delivery_method == 'otj'"><strong>Evaluation Type:</strong> Practical / Hands-on</p>
                        </div>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <!-- LOGIC: If Online, show Signature Image. If OTJ, show Verification Text. -->
                                <t t-if="o.delivery_method == 'online'">
                                    <t t-if="o.signature_image">
                                        <img t-att-src="image_data_uri(o.signature_image)" style="max-height: 100px; max-width: 250px; border-bottom: 1px solid #ccc;"/>
                                    </t>
                                    <t t-else="">
                                        <div style="height: 100px; border-bottom: 1px solid #ccc;"></div>
                                    </t>
                                    <p><strong>Trainee Signature</strong></p>
                                </t>
                                <t t-elif="o.delivery_method == 'otj'">
                                    <div style="height: 100px; display:flex; align-items:end; justify-content:center; border-bottom: 1px solid #ccc;">
                                        <span style="font-style:italic; margin-bottom:5px;">Manager Verified (See Audit Log)</span>
                                    </div>
                                    <p><strong>Practical Verification</strong></p>
                                </t>
                            </div>
                            
                            <div class="col-6 text-center">
                                <!-- Standard Manager line for both -->
                                <div style="height: 100px; margin-top:0px; border-bottom: 1px solid #ccc;"></div>
                                <p><strong>Quality Manager Verification</strong></p>
                            </div>
                        </div>

                        <div class="text-center mt-5" style="font-size: 0.8em; color: #888;">
                            <p>Record ID: <span t-field="o.id"/> | Method: <span t-field="o.delivery_method"/></p>
                            <p>Generated by Odoo Compliance Module</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>